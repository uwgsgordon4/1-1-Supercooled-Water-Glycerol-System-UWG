# ===========================
#  Minimal LAMMPS input
# ===========================

units       real
atom_style  full
boundary    p p p

# -----------------------------
# Potential definitions
# -----------------------------
pair_style      lj/class2/coul/long 10.0
pair_modify     tail yes
bond_style      class2
angle_style     class2
dihedral_style  class2
improper_style  class2
kspace_style    pppm 1.0e-4

# -----------------------------
# System data
# -----------------------------
read_restart    minimized.restart

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

# -----------------------------
# Dynamics
# -----------------------------
timestep        1
velocity        all create 195.0 12345 mom yes rot yes

thermo		100
thermo_style	custom step temp press etotal pe ke vol lx ly lz

# -----------------------------
# Restart files
# -----------------------------
restart		50000 lammps.restart1 lammps.restart2

# -----------------------------
# SHAKE constraints
# Constrain all X-H bonds
# Bond types: 2, 4, 6, 7
# -----------------------------
fix shake	all shake 1.0e-4 20 0 b 2 4 6 7

# =============================
# Stage 1: NVT (1,000,000 steps)
# =============================
fix nvt		all nvt temp 195.0 195.0 100.0

dump eqdump	all custom 1000 eqdump.lammpstrj.gz id type x y z vx vy vz fx fy fz
run		1000000

unfix nvt

# ============================
# Stage 2: NPT equilibration
# ============================
fix npteq	all npt temp 195.0 195.0 100.0 iso 1.0 1.0 1000.0
run		1000000
unfix npteq
undump eqdump

# ===========================
# Step 3: NPT Production
# ===========================
fix nptprod	all npt temp 195.0 195.0 100.0 iso 1.0 1.0 1000.0

dump mydump	all custom 1000 dump.lammpstrj.gz id type x y z vx vy vz fx fy fz
run		2000000

write_restart	final.restart

undump mydump
unfix nptprod
unfix shake
